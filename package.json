{
  "name": "paseo-omni-reader",
  "version": "0.1.3",
  "description": "Read streaming LaTeX, preview workspace documents and spreadsheets, and zoom and pan PDFs in Paseo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fu021/paseo-omni-reader.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "paseo-plugin.json",
    "README.zh-CN.md",
    "OVERVIEW*.md",
    "assets/",
    "vendor/office2pdf/*.wasm",
    "vendor/office2pdf/*.cjs",
    "vendor/office2pdf/*.txt",
    "vendor/office2pdf/LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "scripts/prepare-office.mjs",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "pretest:office": "npm run build",
    "test:office": "node --import tsx test/integration/office.test.ts",
    "prepack:release": "npm run build",
    "pack:release": "node scripts/pack-release.mjs",
    "check:package": "npm run pack:release -- --check"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@inkbar/fonts": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "micromark": "4.0.3",
    "micromark-util-decode-string": "2.0.1",
    "refractor": "5.0.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.17.4",
    "@tanstack/react-query": "5.90.11",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/yauzl": "3.4.0",
    "fflate": "0.8.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
